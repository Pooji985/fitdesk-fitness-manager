PROJECT_NAME="FitDesk Fitness Class & Membership Manager"
API_V1_STR="/api/v1"
# The default business database is backend/fitdesk.db, independent of the launch directory.
# Set DATABASE_URL only when intentionally selecting another existing database.
# Authentication credentials use a separate backend/fitdesk-auth.db sidecar by default.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
